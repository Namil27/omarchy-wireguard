/* Fallback palette; the app applies colors from the active Omarchy theme. */
* {
    background: #1a1b26;
    foreground: #a9b1d6;
    selected: #292e42;
    accent: #7aa2f7;
}
window {
    width: 30%;
    background-color: @background;
    border: 1px;
    border-color: @accent;
    border-radius: 8px;
}
mainbox {
    background-color: @background;
    padding: 12px;
    spacing: 8px;
}
inputbar {
    background-color: @selected;
    padding: 8px;
    border-radius: 5px;
}
prompt {
    background-color: transparent;
    text-color: @accent;
}
entry {
    background-color: transparent;
    text-color: @foreground;
}
listview {
    background-color: @background;
    lines: 10;
    spacing: 4px;
}
element {
    background-color: @background;
    padding: 7px;
    border-radius: 5px;
}
element selected { background-color: @selected; }
element-text {
    background-color: transparent;
    text-color: @foreground;
}
